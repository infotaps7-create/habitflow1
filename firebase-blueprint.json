{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, configuration, and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "currencySymbol": { "type": "string", "maxLength": 5 },
        "level": { "type": "number" },
        "levelTitle": { "type": "string", "maxLength": 50 },
        "totalXp": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "email"]
    },
    "UserLifeState": {
      "title": "UserLifeState",
      "description": "Aggregated user habits, financial ledger, goals, and daily metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habits": { "type": "array" },
        "health": { "type": "object" },
        "transactions": { "type": "array" },
        "investments": { "type": "array" },
        "impulseWishlist": { "type": "array" },
        "timeAllocations": { "type": "array" },
        "learning": { "type": "array" },
        "mind": { "type": "object" },
        "goals": { "type": "array" },
        "deposits": { "type": "array" },
        "morningPriorities": { "type": "array" },
        "eveningReview": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "habits", "health"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account profile document"
    },
    "/users/{userId}/data/state": {
      "schema": { "$ref": "#/entities/UserLifeState" },
      "description": "User active LifeOS state data"
    }
  }
}
